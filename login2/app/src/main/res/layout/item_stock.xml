<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingVertical="12dp">

    <!-- Símbolo -->
    <TextView
        android:id="@+id/tvSymbol"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="AAPL-"
        android:textStyle="bold"
        android:textSize="16sp"
        android:textColor="#1A2C48"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>

    <!-- Empresa -->
    <TextView
        android:id="@+id/tvCompany"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="APPLE INC"
        android:textSize="12sp"
        android:textColor="#888888"
        app:layout_constraintTop_toBottomOf="@id/tvSymbol"
        app:layout_constraintStart_toStartOf="parent"/>

    <!-- Sparkline (placeholder) -->
    <ImageView
        android:id="@+id/ivSparkline"
        android:layout_width="40dp"
        android:layout_height="20dp"
        android:src="@drawable/ic_sparkline_placeholder"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="@id/tvCompany"
        app:layout_constraintStart_toEndOf="@id/tvCompany"
        android:layout_marginStart="8dp"/>

    <!-- Precio -->
    <TextView
        android:id="@+id/tvPrice"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="172.07$"
        android:textStyle="bold"
        android:textSize="16sp"
        android:textColor="#1A2C48"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- % cambio -->
    <TextView
        android:id="@+id/tvPercent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="+1.93%"
        android:textSize="12sp"
        android:textColor="#FFFFFF"
        android:padding="4dp"
        android:background="@drawable/bg_percent_green"
        app:layout_constraintTop_toBottomOf="@id/tvPrice"
        app:layout_constraintEnd_toEndOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
